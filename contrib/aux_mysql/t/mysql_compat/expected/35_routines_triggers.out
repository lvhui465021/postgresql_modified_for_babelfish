--------------
CREATE PROCEDURE mysql_routine_add_log(IN p_id INT, IN p_value INT)
MODIFIES SQL DATA
BEGIN ATOMIC
  INSERT INTO mysql_routine_log(id, value_int)
  VALUES (p_id, p_value);
END
