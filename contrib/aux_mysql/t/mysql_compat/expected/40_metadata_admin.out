SHOW CREATE TRIGGER aitmysql_metadata_table
--------------

Trigger	sql_mode	SQL Original Statement	character_set_client	collation_connection	Database Collation	Created
aitmysql_metadata_table	ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION	CREATE DEFINER=`test`@`%` TRIGGER `aitmysql_metadata_table` BEFORE INSERT ON `mysql_metadata_table` FOR EACH ROW BEGIN if New.id is not null then if 0 < New.id then PERFORM setval('mysql_compat_metadata.seqmysql_metadata_table'::regclass, New.id, true);elsif 0 = New.id then New.id = (select nextval('mysql_compat_metadata.seqmysql_metadata_table'::regclass)); end if; else New.id = (select nextval('mysql_compat_metadata.seqmysql_metadata_table'::regclass)); end if; RETURN NEW; END;	utf8mb4	utf8mb4_0900_ai_ci	utf8mb4_0900_ai_ci	NULL
