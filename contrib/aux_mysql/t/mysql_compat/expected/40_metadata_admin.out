Table	Create Table
mysql_metadata_table	CREATE TABLE `mysql_metadata_table` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `code` varchar(20) NOT NULL COLLATE case_insensitive,
  `value_int` int(11) DEFAULT 0 COMMENT 'metadata column',
  PRIMARY KEY (`id`),
  UNIQUE KEY `mysql_metadata_table_code_key`(`code`),
  KEY `mysql_metadata_value_index`(`value_int`)
) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8mb4 COMMENT 'metadata table'
