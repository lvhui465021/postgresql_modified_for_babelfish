CREATE TRIGGER mysql_ddl_after_insert AFTER INSERT ON mysql_ddl_trigger_source
FOR EACH ROW INSERT INTO mysql_ddl_trigger_audit(id, value_int)
VALUES (NEW.id, NEW.value_int)
